<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/hud_panel_background"
    android:padding="12dp"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvLogName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ANKIT GOTHWAL"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/tvLogBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[AUTHORIZED]"
            android:textColor="@color/jarvis_green_online"
            android:textSize="11sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvLogTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TIME: 11 Nov 2026, 02:45:10 PM"
        android:textColor="@color/jarvis_cyan"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/tvLogTelemetry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CONFIDENCE: 89% // SOURCE: TAPO C200"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:layout_marginTop="2dp" />

</LinearLayout>
